{
  "info": {
    "name": "HILMS - Temporary Password Workflow",
    "_postman_id": "b7f2c9a4-1d3e-4a55-9c10-hilms0000001",
    "description": "End-to-end verification of the admin/system-created Patient temporary-password workflow.\n\nSet collection variables `baseUrl` and `adminEmail` / `adminPassword`, then run the folders in order. Steps 1-4 are the happy path; steps 5-7 are the security and failure cases.\n\nIMPORTANT: the temporary password is only ever delivered by email. No response in this collection contains it. To complete the flow manually, read it from the patient's inbox (or the server log when SMTP_HOST is unset).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000", "type": "string" },
    { "key": "adminEmail", "value": "admin@hilms.local", "type": "string" },
    { "key": "adminPassword", "value": "Admin@12345", "type": "string" },
    { "key": "patientName", "value": "Walk-in Patient", "type": "string" },
    { "key": "patientEmail", "value": "walkin.patient@example.com", "type": "string" },
    { "key": "patientContact", "value": "+9779800000001", "type": "string" },
    { "key": "temporaryPassword", "value": "", "type": "string", "description": "Paste from the email. Left empty on purpose - the API never returns it." },
    { "key": "newPassword", "value": "NewPatient!2026", "type": "string" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{adminToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "1. Admin signs in",
      "item": [
        {
          "name": "Login as Admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('role is admin', () => pm.expect(body.data.user.role).to.eql('admin'));",
                  "pm.test('mustChangePassword is false', () => pm.expect(body.data.user.mustChangePassword).to.eql(false));",
                  "pm.collectionVariables.set('adminToken', body.data.token);"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "2. Admin creates a Patient (happy path)",
      "item": [
        {
          "name": "POST /admin/patients",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json().data;",
                  "pm.test('role is patient', () => pm.expect(body.user.role).to.eql('patient'));",
                  "pm.test('status is APPROVED', () => pm.expect(body.user.status).to.eql('APPROVED'));",
                  "pm.test('mustChangePassword is true', () => pm.expect(body.user.mustChangePassword).to.eql(true));",
                  "pm.test('email was delivered', () => pm.expect(body.emailDelivered).to.eql(true));",
                  "pm.test('the response NEVER contains the password', () => {",
                  "  const raw = pm.response.text().toLowerCase();",
                  "  pm.expect(raw).to.not.include('temporarypassword');",
                  "  pm.expect(raw).to.not.include('passwordhash');",
                  "  pm.expect(raw).to.not.include('bcrypt');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"{{patientName}}\",\n  \"email\": \"{{patientEmail}}\",\n  \"contactNumber\": \"{{patientContact}}\",\n  \"address\": \"Outpatient, HILMS\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/admin/patients", "host": ["{{baseUrl}}"], "path": ["api", "admin", "patients"] },
            "description": "Generates a CSPRNG temporary password, bcrypt-hashes it, sets mustChangePassword=true, and emails it. No password field is accepted."
          }
        },
        {
          "name": "Duplicate email is refused",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('409 Conflict', () => pm.response.to.have.status(409));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Someone Else\",\n  \"email\": \"{{patientEmail}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/patients", "host": ["{{baseUrl}}"], "path": ["api", "admin", "patients"] }
          }
        }
      ]
    },
    {
      "name": "3. Patient logs in with the temporary password",
      "item": [
        {
          "name": "Login with temporary password",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data;",
                  "pm.test('mustChangePassword is true', () => pm.expect(body.user.mustChangePassword).to.eql(true));",
                  "pm.test('role is patient', () => pm.expect(body.user.role).to.eql('patient'));",
                  "pm.collectionVariables.set('patientToken', body.token);",
                  "pm.test('temporaryPassword variable must be filled in manually', function () {",
                  "  pm.expect(pm.collectionVariables.get('temporaryPassword')).to.not.eql('');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{temporaryPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "4. Normal functionality is blocked (mustChangePassword)",
      "item": [
        {
          "name": "GET /auth/me is allowed (the client needs the session)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "Admin routes are refused",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/users", "host": ["{{baseUrl}}"], "path": ["api", "admin", "users"] }
          }
        },
        {
          "name": "Lab routes are refused",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}" }] },
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/lab/requests", "host": ["{{baseUrl}}"], "path": ["api", "lab", "requests"] }
          }
        }
      ]
    },
    {
      "name": "5. Patient changes the password",
      "item": [
        {
          "name": "Wrong temporary password is rejected",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"temporaryPassword\": \"DefinitelyWrong!1\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "change-password"] }
          }
        },
        {
          "name": "Mismatched confirmation is rejected",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"temporaryPassword\": \"{{temporaryPassword}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"SomethingElse!9\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "change-password"] }
          }
        },
        {
          "name": "Reusing the temporary password is rejected",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"temporaryPassword\": \"{{temporaryPassword}}\",\n  \"newPassword\": \"{{temporaryPassword}}\",\n  \"confirmPassword\": \"{{temporaryPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "change-password"] }
          }
        },
        {
          "name": "Correct change succeeds",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data;",
                  "pm.test('mustChangePassword is now false', () => pm.expect(body.mustChangePassword).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"temporaryPassword\": \"{{temporaryPassword}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/change-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "change-password"] }
          }
        }
      ]
    },
    {
      "name": "6. The temporary password is revoked",
      "item": [
        {
          "name": "Old temporary password no longer works",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{temporaryPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "New password works",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json().data;",
                  "pm.test('mustChangePassword stays false', () => pm.expect(body.user.mustChangePassword).to.eql(false));"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{patientEmail}}\",\n  \"password\": \"{{newPassword}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          }
        }
      ]
    },
    {
      "name": "7. Negative cases and authorization",
      "item": [
        {
          "name": "Unauthenticated create is 401",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"No Token\",\n  \"email\": \"no.token@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/patients", "host": ["{{baseUrl}}"], "path": ["api", "admin", "patients"] }
          }
        },
        {
          "name": "Patient cannot create a Patient (403)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{patientToken}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Self Provision\",\n  \"email\": \"self.provision@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/patients", "host": ["{{baseUrl}}"], "path": ["api", "admin", "patients"] }
          }
        },
        {
          "name": "Client-supplied password is rejected (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Bad Actor\",\n  \"email\": \"bad.actor@example.com\",\n  \"password\": \"AttackerChosen1\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/patients", "host": ["{{baseUrl}}"], "path": ["api", "admin", "patients"] }
          }
        },
        {
          "name": "Role escalation in the body is rejected (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Escalation\",\n  \"email\": \"escalation@example.com\",\n  \"role\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/patients", "host": ["{{baseUrl}}"], "path": ["api", "admin", "patients"] }
          }
        },
        {
          "name": "Missing name is rejected (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('400 Bad Request', () => pm.response.to.have.status(400));"] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"no.name@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/admin/patients", "host": ["{{baseUrl}}"], "path": ["api", "admin", "patients"] }
          }
        },
        {
          "name": "Provisioning is auditable",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const logs = JSON.stringify(pm.response.json().data);",
                  "pm.test('PATIENT_ACCOUNT_CREATED is present', () => pm.expect(logs).to.include('PATIENT_ACCOUNT_CREATED'));",
                  "pm.test('the audit trail contains no password', () => pm.expect(logs.toLowerCase()).to.not.include('temporarypassword'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/admin/audit-logs?limit=50", "host": ["{{baseUrl}}"], "path": ["api", "admin", "audit-logs"], "query": [{ "key": "limit", "value": "50" }] }
          }
        }
      ]
    }
  ]
}
