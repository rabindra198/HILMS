# ---- Runtime ---------------------------------------------------------
# Port the Express server listens on.
# The Vite dev proxy defaults to http://localhost:5000 - keep these in sync.
PORT=5000

NODE_ENV=development

# Origin of the React dev server, used for the CORS credentialed allowlist.
CLIENT_URL=http://localhost:5173

# ---- Database --------------------------------------------------------
# Required. Replace with your own connection string.
# NEVER commit a real credential to this file.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/?appName=<app>

# ---- Auth ------------------------------------------------------------
# Required. Use a long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string

# Session lifetime for the JWT / auth cookie.
JWT_EXPIRES_IN=1d

# FR-AUTH-10 / NFR-04: temporary account lockout. After LOGIN_MAX_ATTEMPTS
# consecutive failed sign-ins the account is locked for LOGIN_LOCKOUT_MINUTES.
# A successful sign-in resets the counter; an expired lock grants a fresh window.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# FR-AUTH-08: lifetime of a "Remember me" sign-in (server token + cookie).
REMEMBER_ME_DAYS=30

# FR-AUTH-09: how long each sign-in history record is kept (TTL).
LOGIN_HISTORY_TTL_DAYS=90

# ---- Transactional email (SMTP) ----------------------------------------
# SRS 5.3: "Email shall be sent through a configured SMTP provider."
#
# Used for: Patient welcome, Doctor/Laboratory approval (carries the temporary
# password), request decline, and password reset links.
#
# Leave the values blank in development: the server still runs, logs a warning
# and records the delivery failure, so the flows can be exercised locally.
# Fill in real credentials to enable actual delivery.
SMTP_HOST=
SMTP_PORT=587
# Set to true only for implicit TLS (typically port 465). Leave unset to let
# the server pick based on the port.
# SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Must be a sender on a domain your SMTP provider is allowed to send for.
SMTP_FROM=HILMS <no-reply@your-domain.com>
SUPPORT_EMAIL=support@your-domain.com

# Optional override; the SMTP transport is the only provider used.
# EMAIL_PROVIDER=smtp

# Public origin of the React app. Used for CORS and to build the password
# reset links that are emailed out. APP_URL defaults to CLIENT_URL.
APP_URL=http://localhost:5173

# ---- Online payment (eSewa ePay) ---------------------------------------
# SRS 5.4: online payment through a configured gateway.
# eSewa REPLACED Khalti. Khalti's credentials are no longer read by this server
# and there is no Khalti route, service or component left.
#
# ESEWA_SECRET_KEY is server-side only. It must never be returned by an endpoint,
# logged, or bundled into the React app - the browser receives only the fields
# that are posted to eSewa.
#
# With PRODUCT_CODE or SECRET_KEY blank the server still boots, "Pay with eSewa"
# is not offered anywhere, and no payment can be initiated - an unconfigured
# deployment fails closed rather than pretending to take money.
#
# ESEWA_ENVIRONMENT: "uat" for the eSewa test gateway, "production" for live.
ESEWA_ENVIRONMENT=uat
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# Where eSewa sends the customer back to. Both must be absolute URLs, and both
# must point at the BACKEND: the backend verifies the transaction and then
# forwards the browser to the React result page. Never point these at the SPA.
ESEWA_SUCCESS_URL=http://localhost:5000/payments/esewa/success
ESEWA_FAILURE_URL=http://localhost:5000/payments/esewa/failure
#
# Optional endpoint overrides. eSewa publishes one form host and one status-check
# host per environment, and provisions each merchant against a specific one, so
# both can be pinned without a code change.
# ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
# ESEWA_STATUS_CHECK_URL=https://uat.esewa.com.np/api/epay/transaction/status/

# ---- Bootstrap seed (npm run seed) -----------------------------------
# Admin is NOT self-service and is never created through the
# Request Access dialog, so the first one is provisioned out-of-band by this
# script. Set these before seeding in production - the script refuses to run
# with its development defaults when NODE_ENV=production.
SEED_ADMIN_NAME=HILMS Admin
SEED_ADMIN_EMAIL=admin@hilms.com
SEED_ADMIN_PASSWORD=

# Plain aliases for the Admin above. SEED_ADMIN_* wins when both are set.
# The local development Admin from the SRS, used to test the Request Access
# workflow. Never commit a real password, and never reuse this in production.
# ADMIN_NAME=System Admin
# ADMIN_EMAIL=admin@hilms.local
# ADMIN_PASSWORD=Admin@12345

# Set to "true" to reset an existing seeded account's password back to the
# value above. Leave unset/false so re-running the seed is non-destructive.
SEED_RESET_PASSWORD=false
