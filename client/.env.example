# Example client environment for HILMS.
#
# Copy to `client/.env` and adjust. Only variables prefixed with VITE_ are
# exposed to the browser bundle, so never place secrets in this file.

# --- Development proxy -------------------------------------------------------
# Target the Vite dev-server proxy forwards `/api` requests to.
VITE_API_PROXY_TARGET=http://localhost:5000

# --- GlobalFooter contact details -------------------------------------------
# The footer renders contact rows ONLY for values set here. Leave them blank and
# the footer shows a neutral "configured by your hospital administrator" line
# rather than inventing contact details.
#
# VITE_HILMS_ORGANISATION=General Hospital
# VITE_HILMS_SUPPORT_EMAIL=support@example.org
# VITE_HILMS_SUPPORT_PHONE=+977-1-0000000
# VITE_HILMS_LOCATION=Building A, Level 2
# VITE_HILMS_SUPPORT_HOURS=Sunday-Friday, 08:00-17:00

# --- Copyright year ----------------------------------------------------------
# Defaults to the current year when unset.
# VITE_HILMS_COPYRIGHT_YEAR=2026
